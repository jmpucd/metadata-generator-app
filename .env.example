# Copy this to .env and fill in your values
OLLAMA_TOKEN=your-ollama-bearer-token-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Backend: ollama | vllm | claude | qwen_vl | mock
MODEL_BACKEND=ollama

# Optional overrides (defaults shown)
# OLLAMA_BASE_URL=https://samwise.library.ucdavis.edu/ollama
# OLLAMA_MODEL=qwen2.5vl:32b
# CLAUDE_MODEL=claude-opus-4-7
# IMAGES_DIR=/digitization/Metadata-Generator-App/images/incoming
# OLLAMA_IMAGE_MAX_PX=2048
# OLLAMA_IMAGE_QUALITY=85

# --- vLLM (OpenAI-compatible) backend, e.g. Qwen 3.6 -------------------------
# Set MODEL_BACKEND=vllm to use it. This is NOT Ollama:
#   * base URL ends in /v1, calls go to /v1/chat/completions
#   * model is the EXACT served id (check: curl <BASE>/models), not an ollama tag
#   * no API key needed; reachable on-campus / VPN only
# MODEL_BACKEND=vllm
# VLLM_BASE_URL=http://cyberdyne01.library.ucdavis.edu:30804/v1
# VLLM_MODEL=Qwen/Qwen3.6-35B-A3B
# VLLM_API_KEY=
# VLLM_MAX_TOKENS=1024
# VLLM_ENABLE_THINKING=false   # if true, raise VLLM_MAX_TOKENS (think block uses budget)
